{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "source": "functions"
    }
  ],
  "hosting": {
    "site": "bethanyblooms-89dcc",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/service-worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,no-store,must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,must-revalidate"
          }
        ]
      },
      {
        "source": "/@(workshops|cut-flowers|events|products|cart|checkout|gallery|contact|account|subscriptions|payment|gift-cards|reset-password|privacy-policy|disclaimer|design|admin){,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,must-revalidate"
          }
        ]
      },
      {
        "source": "/404.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,no-store,must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/robot.txt",
        "function": "robotsTxt"
      },
      {
        "source": "/sitemap.xml",
        "function": "sitemapXml"
      },
      {
        "source": "/robots.txt",
        "function": "robotsTxt"
      },
      {
        "source": "/",
        "destination": "/index.html"
      },
      {
        "regex": "^/(?:workshops|cut-flowers|events|products|cart|checkout|gallery|contact|account|subscriptions|payment|gift-cards|reset-password|privacy-policy|disclaimer|design|admin)(?:/[^.]*)?$",
        "destination": "/index.html"
      }
    ]
  }
}
